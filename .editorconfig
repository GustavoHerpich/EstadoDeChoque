root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]

indent_style = space
indent_size = 4

# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Braces
csharp_new_line_before_open_brace = all

# Var preferences (bem aceito em Unity hoje)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression bodies (evita abuso)
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Null checks
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Private fields: _camelCase
dotnet_naming_rule.private_fields_rule.severity = suggestion
dotnet_naming_rule.private_fields_rule.symbols = private_fields
dotnet_naming_rule.private_fields_rule.style = private_fields_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.private_fields_style.capitalization = camel_case
dotnet_naming_style.private_fields_style.required_prefix = _

# Serialized fields (Unity)
dotnet_naming_rule.serialized_fields_rule.severity = suggestion
dotnet_naming_rule.serialized_fields_rule.symbols = serialized_fields
dotnet_naming_rule.serialized_fields_rule.style = private_fields_style

dotnet_naming_symbols.serialized_fields.applicable_kinds = field
dotnet_naming_symbols.serialized_fields.applicable_accessibilities = private

# Public members: PascalCase
dotnet_naming_rule.public_members_rule.severity = suggestion
dotnet_naming_rule.public_members_rule.symbols = public_members
dotnet_naming_rule.public_members_rule.style = pascal_case_style

dotnet_naming_symbols.public_members.applicable_kinds = property, method, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Evita código morto
dotnet_diagnostic.CS0168.severity = warning
dotnet_diagnostic.CS0219.severity = warning

# Usings desnecessários
dotnet_diagnostic.IDE0005.severity = warning

# Preferir readonly
dotnet_diagnostic.IDE0044.severity = suggestion

# Evitar APIs obsoletas
dotnet_diagnostic.CS0618.severity = warning
